</section>

<!-- STATS -->
<section class="stats-bar">
  <div class="stats-inner">
    <div class="stat-item">
      <div class="stat-num-wrap"><span class="stat-num" data-target="6">6</span><span class="stat-suf">+</span></div>
      <span class="stat-label">Expert Barbers</span>
    </div>
