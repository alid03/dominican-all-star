<!-- HERO -->
<section class="hero">
  <div class="hero-img">
    <img src="assets/images/gallery-03-action-locs-design.jpg" alt="Barber at work at Dominican All Star Marietta GA"/>
  </div>
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <p class="hero-eyebrow" data-t="h-over">Marietta, Georgia · Walk-ins Welcome · Open 7 Days</p>
    <h1 class="hero-headline">DOMINICAN<br><span class="red">ALL STAR</span></h1>
    <div class="hero-bottom">
      <p class="hero-sub" data-t="h-sub">Where every cut is a culture.</p>
      <a href="tel:+16785403610" class="btn-main" data-t="h-cta">Call Us · (678) 540-3610</a>
      <a href="https://maps.google.com/?q=677+Franklin+Gateway+SE+Marietta+GA" target="_blank" class="hero-dir" data-t="h-dir">Get Directions ↗</a>
    </div>
