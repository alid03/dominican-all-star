      <li class="svc-row"><span class="svc-name" data-t="s5">Braids & Cornrows</span><span class="svc-dots"></span><span class="svc-price" data-t="p5">By style</span></li>
      <li class="svc-row"><span class="svc-name" data-t="s6">Head Shave</span><span class="svc-dots"></span><span class="svc-price" data-t="p6">From $30</span></li>
      <li class="svc-row"><span class="svc-name" data-t="s7">Full Service</span><span class="svc-dots"></span><span class="svc-price" data-t="p7">From $45</span></li>
