<!DOCTYPE html>
<html lang="en" data-lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Dominican All Star — Barbershop & Salon · Marietta, GA</title>
<meta name="description" content="Dominican All Star Barbershop & Glam Dominican Salon. Expert cuts, fades, braids, color & more. Walk-ins welcome. 677 Franklin Gateway SE, Marietta GA."/>

<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link href="https://fonts.gstatic.com" rel="preconnect" crossorigin/>
<script src="https://ajax.googleapis.com/ajax/libs/webfont/1.6.26/webfont.js"></script>
<script>
  WebFont.load({
    google: {
      families: [
        "Bebas Neue",
        "Montserrat:300,400,500,600,700,800,900",
        "Bitter:400,700",
        "Lato:300,400,700"
      ]
    }
  });
</script>

<style>
/* ── RESET ─────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  font-family: 'Lato', sans-serif;
  font-weight: 400;
  color: #222;
  background: #fff;
  overflow-x: hidden;
}
img { display: block; width: 100%; height: 100%; object-fit: cover; }
a { text-decoration: none; color: inherit; }

/* ── NAV ────────────────────────────────────── */
.navbar {
  position: fixed; top: 0; left: 0; right: 0; z-index: 999;
  background: #1a1010;
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 3rem;
  height: 72px;
  border-bottom: 2px solid #c0392b;
}
.nav-logo {
  display: flex; align-items: center; gap: .6rem;
  flex-shrink: 0;
}
.logo-img {
  display: block;
  width: auto; height: 44px;
  object-fit: contain;
}
.logo-text {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 1.5rem;
  letter-spacing: .08em;
  color: #fff;
}
.logo-text .red { color: #c0392b; }
.nav-links {
  display: flex; gap: 0; list-style: none;
}
.nav-links a {
  font-family: 'Montserrat', sans-serif;
  font-size: .7rem;
  font-weight: 600;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: rgba(255,255,255,.5);
  padding: .5rem 1.5rem;
  transition: color .2s;
}
.nav-links a:hover { color: #fff; }
.nav-right { display: flex; align-items: center; gap: 1.5rem; }
.lang-wrap {
  display: flex; border: 1px solid rgba(255,255,255,.15); border-radius: 2px; overflow: hidden;
}
.lang-wrap button {
  font-family: 'Montserrat', sans-serif;
  font-size: .62rem; font-weight: 600;
  letter-spacing: .1em; text-transform: uppercase;
  color: rgba(255,255,255,.35);
  background: none; border: none; cursor: pointer;
  padding: .28rem .6rem;
  transition: background .2s, color .2s;
}
.lang-wrap button.on { background: #c0392b; color: #fff; }
.nav-phone {
  font-family: 'Montserrat', sans-serif;
  font-size: .68rem; font-weight: 600;
  letter-spacing: .1em;
  color: rgba(255,255,255,.55);
  white-space: nowrap;
  transition: color .2s;
}
.nav-phone:hover { color: #fff; }

/* hamburger */
.hamburger {
  display: none;
  background: none; border: none; cursor: pointer;
  padding: .35rem;
  flex-direction: column; gap: 5px;
  margin-left: .5rem;
}
.hamburger span {
  display: block; width: 22px; height: 2px;
  background: rgba(255,255,255,.8);
  transition: transform .28s ease, opacity .28s ease;
}
.hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.hamburger.open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
.hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

/* ── HERO ────────────────────────────────────── */
.hero {
  margin-top: 72px;
  height: calc(100svh - 72px);
  position: relative;
  overflow: hidden;
}
.hero-img { position: absolute; inset: 0; }
.hero-img img { object-position: center 25%; }
.hero-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(
    to bottom,
    rgba(20,10,10,.1) 0%,
    rgba(20,10,10,.45) 50%,
    rgba(20,10,10,.9) 100%
  );
}
.hero-content {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  padding: 4rem 3rem 5rem;
}
.hero-eyebrow {
  font-family: 'Montserrat', sans-serif;
  font-size: .7rem; font-weight: 600;
  letter-spacing: .28em; text-transform: uppercase;
  color: rgba(255,255,255,.5);
  margin-bottom: 1.1rem;
}
.hero-headline {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(5rem, 13vw, 12rem);
  line-height: .9; letter-spacing: .03em;
  color: #fff;
}
.hero-headline .red { color: #c0392b; }
.hero-bottom {
  margin-top: 2.25rem;
  display: flex; align-items: center; gap: 1.75rem;
  flex-wrap: wrap;
}
.hero-sub {
  font-family: 'Lato', sans-serif;
  font-size: 1rem;
  color: rgba(255,255,255,.5);
  font-style: italic;
}
.btn-main {
  font-family: 'Montserrat', sans-serif;
  font-size: .72rem; font-weight: 700;
  letter-spacing: .15em; text-transform: uppercase;
  color: #fff; background: #c0392b;
  padding: 1rem 2rem;
  transition: background .2s;
  white-space: nowrap;
}
.btn-main:hover { background: #a93226; }
.hero-dir {
  font-family: 'Montserrat', sans-serif;
  font-size: .68rem; font-weight: 600;
  letter-spacing: .12em; text-transform: uppercase;
  color: rgba(255,255,255,.62);
  border-bottom: 1px solid rgba(255,255,255,.25);
  padding-bottom: 1px;
  transition: color .2s, border-color .2s;
}
.hero-dir:hover { color: #fff; border-color: rgba(255,255,255,.55); }

/* ── ABOUT (2-col: photo + text) ── */
.about-section {
  background: #fff;
  overflow: hidden;
}
.about-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: 640px;
}
.about-photo {
  position: relative;
  overflow: hidden;
}
.about-photo img {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  object-position: center 20%;
}
.about-text {
  padding: 6rem 5rem 6rem 4.5rem;
  display: flex; flex-direction: column; justify-content: center;
}
.about-text .label {
  font-family: 'Montserrat', sans-serif;
  font-size: .68rem; font-weight: 700;
  letter-spacing: .24em; text-transform: uppercase;
  color: #c0392b;
  margin-bottom: 1.25rem;
}
.about-text h2 {
  font-family: 'Bitter', serif;
  font-size: clamp(1.7rem, 2.8vw, 2.4rem);
  font-weight: 700;
  line-height: 1.2;
  color: #1a1010;
  margin-bottom: 1.75rem;
}
.about-text p {
  font-family: 'Lato', sans-serif;
  font-size: .97rem;
  color: #555;
  line-height: 1.9;
  margin-bottom: 1.1rem;
}
.about-pull {
  margin-top: 2rem;
  padding-left: 1.4rem;
  border-left: 3px solid #c0392b;
}
.about-pull p {
  font-family: 'Bitter', serif;
  font-style: italic;
  font-size: 1.05rem;
  color: #444;
  line-height: 1.7;
  margin: 0;
}
.about-pull cite {
  display: block;
  margin-top: .6rem;
  font-family: 'Montserrat', sans-serif;
  font-style: normal;
  font-size: .62rem; font-weight: 600;
  letter-spacing: .14em; text-transform: uppercase;
  color: #aaa;
}

/* ── GALLERY ── */
.gallery-section {
  background: #1a1010;
  padding: 5rem 3rem 5.5rem;
}
.gallery-section .section-head {
  text-align: center;
  margin-bottom: 3rem;
}
.gallery-section .label {
  font-family: 'Montserrat', sans-serif;
  font-size: .68rem; font-weight: 700;
  letter-spacing: .24em; text-transform: uppercase;
  color: #c0392b;
  margin-bottom: .85rem;
}
.gallery-section h2 {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(2.5rem, 5vw, 4rem);
  letter-spacing: .06em;
  color: #fff;
}
/* single 4-col grid, 4 rows, all 12 images */
.photo-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  grid-template-rows: 340px 340px 320px 220px;
  gap: 6px;
}
.photo-grid .cell { overflow: hidden; background: #2a1f1f; }
.photo-grid .cell.tall { grid-row: span 2; }
.photo-grid .cell.wide { grid-column: span 2; }
.photo-grid img { transition: transform .5s ease; }
.photo-grid .cell:hover img { transform: scale(1.04); }

/* ── SERVICES ── */
.services-section {
  background: #f5f2ef;
  padding: 7rem 3rem;
}
.services-inner {
  max-width: 1100px; margin: 0 auto;
  display: grid; grid-template-columns: 1fr 1.8fr; gap: 6rem; align-items: start;
}
.services-left .label {
  font-family: 'Montserrat', sans-serif;
  font-size: .68rem; font-weight: 700;
  letter-spacing: .24em; text-transform: uppercase;
  color: #c0392b; margin-bottom: 1rem;
}
.services-left h2 {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(3rem, 5vw, 4.5rem);
  letter-spacing: .04em; color: #1a1010;
  line-height: 1; margin-bottom: 1.25rem;
}
.services-left p {
  font-family: 'Lato', sans-serif;
  font-size: .95rem; color: #666; line-height: 1.8;
  margin-bottom: 1.5rem;
}
.walk-tag {
  display: inline-block;
  font-family: 'Montserrat', sans-serif;
  font-size: .63rem; font-weight: 700;
  letter-spacing: .18em; text-transform: uppercase;
  color: #c0392b;
  border: 1.5px solid #c0392b;
  padding: .35rem .85rem;
}
.svc-list { list-style: none; }
.svc-row {
  display: flex; align-items: center; gap: .5rem;
  padding: 1.25rem 0;
  border-bottom: 1px solid #ddd;
}
.svc-row:first-child { border-top: 1px solid #ddd; }
.svc-name {
  font-family: 'Bitter', serif;
  font-size: 1.1rem; font-weight: 700;
  color: #1a1010; flex: 1;
}
.svc-dots {
  flex: 1; border-bottom: 1px dashed #ccc;
  margin: 0 .5rem; position: relative; top: -.2rem;
}
.svc-price {
  font-family: 'Montserrat', sans-serif;
  font-size: .83rem; font-weight: 700;
  color: #c0392b; white-space: nowrap;
}

/* ── SALON (dark) ── */
.salon-section {
  background: #1a1010;
  display: grid; grid-template-columns: 1fr 1fr;
  min-height: 600px;
}
.salon-img { position: relative; overflow: hidden; min-height: 500px; }
.salon-img img { object-position: center 20%; }
.salon-content {
  padding: 6rem 4.5rem;
  display: flex; flex-direction: column; justify-content: center;
}
.salon-content .label {
  font-family: 'Montserrat', sans-serif;
  font-size: .68rem; font-weight: 700;
  letter-spacing: .24em; text-transform: uppercase;
  color: #c0392b; margin-bottom: 1rem;
}
.salon-content h2 {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(2.5rem, 4vw, 3.8rem);
  letter-spacing: .04em; color: #fff;
  line-height: 1; margin-bottom: 1.5rem;
}
.salon-content p {
  font-family: 'Lato', sans-serif;
  font-size: .95rem; color: rgba(255,255,255,.45);
  line-height: 1.85; margin-bottom: 1.75rem;
}
.salon-tags {
  display: flex; flex-wrap: wrap; gap: .5rem;
  margin-bottom: 2rem;
}
.salon-tag {
  font-family: 'Montserrat', sans-serif;
  font-size: .63rem; font-weight: 600;
  letter-spacing: .1em; text-transform: uppercase;
  color: rgba(255,255,255,.4);
  border: 1px solid rgba(255,255,255,.1);
  padding: .3rem .75rem;
}
.salon-phone {
  font-family: 'Montserrat', sans-serif;
  font-size: .85rem; font-weight: 600;
  color: #c0392b; letter-spacing: .06em;
  transition: color .2s;
}
.salon-phone:hover { color: #e04034; }

/* ── REVIEWS ── */
.reviews-section {
  background: #fff;
  padding: 7rem 3rem;
}
.reviews-inner {
  max-width: 1100px; margin: 0 auto;
}
.reviews-section .label {
  font-family: 'Montserrat', sans-serif;
  font-size: .68rem; font-weight: 700;
  letter-spacing: .24em; text-transform: uppercase;
  color: #c0392b;
  margin-bottom: 3.5rem;
  text-align: center;
  display: block;
}
/* featured review */
.rev-feature {
  text-align: center;
  padding: 0 3rem 3.5rem;
  border-bottom: 1px solid #ececec;
  margin-bottom: 3.5rem;
}
.rev-feature .rev-text {
  font-family: 'Bitter', serif;
  font-style: italic;
  font-size: clamp(1.15rem, 2vw, 1.5rem);
  color: #333; line-height: 1.72;
  margin-bottom: 1.5rem;
  max-width: 800px; margin-left: auto; margin-right: auto;
}
.rev-feature .stars {
  display: block;
  color: #c0392b; font-size: .82rem; letter-spacing: .12em;
  margin-bottom: .5rem;
}
.rev-feature .rev-by {
  font-family: 'Montserrat', sans-serif;
  font-size: .62rem; font-weight: 700;
  letter-spacing: .18em; text-transform: uppercase; color: #bbb;
}
/* 2 smaller reviews */
.rev-grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 3.5rem;
}
.rev-card {
  padding-left: 1.5rem;
  border-left: 2px solid #ececec;
}
.stars { color: #c0392b; font-size: .82rem; letter-spacing: .08em; margin-bottom: 1rem; }
.rev-text {
  font-family: 'Bitter', serif;
  font-style: italic; font-size: .95rem;
  color: #555; line-height: 1.8; margin-bottom: 1.1rem;
}
.rev-by {
  font-family: 'Montserrat', sans-serif;
  font-size: .6rem; font-weight: 700;
  letter-spacing: .16em; text-transform: uppercase; color: #ccc;
}

/* ── CONTACT / HOURS ── */
.contact-section {
  background: #f5f2ef;
  padding: 7rem 3rem;
}
.contact-inner {
  max-width: 1100px; margin: 0 auto;
  display: grid; grid-template-columns: 1fr 1fr; gap: 5rem;
}
.contact-left .label, .contact-right .label {
  font-family: 'Montserrat', sans-serif;
  font-size: .68rem; font-weight: 700;
  letter-spacing: .24em; text-transform: uppercase;
  color: #c0392b; margin-bottom: 1rem;
}
.contact-left h2, .contact-right h2 {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(2rem, 3.5vw, 3rem);
  letter-spacing: .04em; color: #1a1010; margin-bottom: 2rem;
}
.locs { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
.loc h3 {
  font-family: 'Bitter', serif;
  font-size: 1rem; font-weight: 700;
  color: #1a1010; margin-bottom: 1rem;
  padding-bottom: .5rem;
  border-bottom: 2px solid #c0392b;
}
.hour-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: .6rem 0; border-bottom: 1px solid #ddd;
  font-size: .84rem;
}
.hour-row:first-of-type { border-top: 1px solid #ddd; }
.hday { color: #888; font-weight: 400; }
.htime { font-weight: 700; color: #1a1010; }
.htime.hi { color: #c0392b; }
.loc-ph {
  margin-top: 1rem;
  font-family: 'Montserrat', sans-serif;
  font-size: .8rem; font-weight: 600; color: #555;
}
.loc-ph a { color: #c0392b; transition: color .2s; }
.loc-ph a:hover { color: #a93226; }
.map-wrap {
  width: 100%; aspect-ratio: 16/10;
  overflow: hidden;
}
.map-wrap iframe { width: 100%; height: 100%; border: none; display: block; }
.links-list { margin-top: 2.5rem; display: flex; flex-direction: column; gap: .65rem; }
.lnk {
  display: flex; align-items: center; gap: .75rem;
  font-family: 'Lato', sans-serif;
  font-size: .87rem; color: #666;
  transition: color .2s;
}
.lnk:hover { color: #c0392b; }
.lnk svg { width: 15px; height: 15px; flex-shrink: 0; color: #c0392b; }

/* ── FOOTER ── */
footer {
  background: #1a1010;
  padding: 2.5rem 3rem;
  display: flex; align-items: center; justify-content: space-between;
  flex-wrap: wrap; gap: 1.25rem;
  border-top: 2px solid #c0392b;
}
.foot-logo {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 1.3rem; letter-spacing: .08em; color: #fff;
}
.foot-logo span { color: #c0392b; }
.foot-links { display: flex; gap: 1.5rem; }
.foot-links a {
  font-family: 'Montserrat', sans-serif;
  font-size: .65rem; font-weight: 600;
  letter-spacing: .14em; text-transform: uppercase;
  color: rgba(255,255,255,.28);
  transition: color .2s;
}
.foot-links a:hover { color: rgba(255,255,255,.8); }
.foot-copy {
  font-family: 'Montserrat', sans-serif;
  font-size: .6rem; color: rgba(255,255,255,.18);
  letter-spacing: .08em;
}

/* ── RESPONSIVE ── */
@media (max-width: 1024px) {
  .about-inner { grid-template-columns: 1fr; }
  .about-photo { min-height: 380px; position: relative; }
  .about-photo img { position: absolute; }
  .about-text { padding: 4.5rem 3rem; }
  .services-inner { grid-template-columns: 1fr; gap: 3rem; }
  .salon-section { grid-template-columns: 1fr; }
  .salon-img { min-height: 50vw; }
  .contact-inner { grid-template-columns: 1fr; gap: 3rem; }
  .locs { grid-template-columns: 1fr; gap: 2rem; }
  .rev-grid { grid-template-columns: 1fr; gap: 2.5rem; }
  /* gallery: 2-col on tablet */
  .photo-grid {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: none;
    grid-auto-rows: 260px;
  }
  .photo-grid .cell.tall { grid-row: span 1; }
  .photo-grid .cell.wide { grid-column: span 2; }
}
@media (max-width: 768px) {
  .navbar { padding: 0 1.25rem; }
  .nav-links {
    display: none;
    position: fixed; top: 72px; left: 0; right: 0;
    background: #1a1010;
    flex-direction: column;
    padding: .5rem 1.5rem 1.5rem;
    border-bottom: 2px solid #c0392b;
    z-index: 998;
  }
  .nav-links.open { display: flex; }
  .nav-links li { border-bottom: 1px solid rgba(255,255,255,.07); }
  .nav-links a { display: block; padding: .9rem 0; font-size: .78rem; }
  .hamburger { display: flex; }
  .nav-right .lang-wrap { display: none; }
  .nav-phone { display: none; }
  .hero-content { padding: 2rem 1.5rem 3.5rem; }
  .about-text { padding: 3.5rem 1.5rem; }
  .gallery-section { padding: 4rem 1.25rem 4.5rem; }
  .services-section { padding: 5rem 1.5rem; }
  .salon-content { padding: 4rem 2rem; }
  .reviews-section { padding: 5rem 1.5rem; }
  .rev-feature { padding: 0 0 2.5rem; }
  .contact-section { padding: 5rem 1.5rem; }
  footer { padding: 2rem 1.5rem; }
  .photo-grid {
    grid-template-columns: 1fr 1fr;
    grid-auto-rows: 200px;
  }
  .photo-grid .cell.tall { grid-row: span 1; }
  .photo-grid .cell.wide { grid-column: span 2; }
}
@media (max-width: 480px) {
  .foot-links { gap: 1rem; }
  .foot-copy { display: none; }
}

/* ── SCROLL REVEAL ── */
.reveal {
  opacity: 0;
  transform: translateY(36px);
  transition: opacity .75s cubic-bezier(.16,1,.3,1), transform .75s cubic-bezier(.16,1,.3,1);
}
.reveal.visible { opacity: 1; transform: translateY(0); }
.reveal-left {
  opacity: 0;
  transform: translateX(-52px);
  transition: opacity .8s cubic-bezier(.16,1,.3,1), transform .8s cubic-bezier(.16,1,.3,1);
}
.reveal-left.visible { opacity: 1; transform: translateX(0); }
.reveal-right {
  opacity: 0;
  transform: translateX(52px);
  transition: opacity .8s cubic-bezier(.16,1,.3,1), transform .8s cubic-bezier(.16,1,.3,1);
}
.reveal-right.visible { opacity: 1; transform: translateX(0); }
.stagger-reveal > * {
  opacity: 0;
  transform: translateY(22px);
  transition: opacity .55s cubic-bezier(.16,1,.3,1), transform .55s cubic-bezier(.16,1,.3,1);
}
.stagger-reveal.visible > * { opacity: 1; transform: translateY(0); }
.stagger-reveal.visible > *:nth-child(1)  { transition-delay: .00s; }
.stagger-reveal.visible > *:nth-child(2)  { transition-delay: .05s; }
.stagger-reveal.visible > *:nth-child(3)  { transition-delay: .10s; }
.stagger-reveal.visible > *:nth-child(4)  { transition-delay: .15s; }
.stagger-reveal.visible > *:nth-child(5)  { transition-delay: .20s; }
.stagger-reveal.visible > *:nth-child(6)  { transition-delay: .25s; }
.stagger-reveal.visible > *:nth-child(7)  { transition-delay: .30s; }
.stagger-reveal.visible > *:nth-child(8)  { transition-delay: .35s; }
.stagger-reveal.visible > *:nth-child(9)  { transition-delay: .40s; }
.stagger-reveal.visible > *:nth-child(10) { transition-delay: .45s; }
.stagger-reveal.visible > *:nth-child(11) { transition-delay: .50s; }
.stagger-reveal.visible > *:nth-child(12) { transition-delay: .55s; }

/* ── STATS BAR ── */
.stats-bar { background: #c0392b; padding: 3.5rem 3rem; }
.stats-inner {
  max-width: 1100px; margin: 0 auto;
  display: grid; grid-template-columns: repeat(4, 1fr);
  gap: 2rem; text-align: center;
}
.stat-item { display: flex; flex-direction: column; align-items: center; gap: .35rem; }
.stat-num-wrap {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(2.8rem, 4.5vw, 4rem);
  line-height: 1; color: #fff;
  display: flex; align-items: baseline; gap: .06em;
}
.stat-suf { font-size: .52em; color: rgba(255,255,255,.6); }
.stat-label {
  font-family: 'Montserrat', sans-serif;
  font-size: .62rem; font-weight: 600;
  letter-spacing: .18em; text-transform: uppercase;
  color: rgba(255,255,255,.55);
}
@media (max-width: 768px) {
  .stats-inner { grid-template-columns: repeat(2, 1fr); }
  .stats-bar { padding: 2.5rem 1.5rem; }
}

/* ── GALLERY EXPAND ICON ── */
.photo-grid .cell { cursor: zoom-in; position: relative; }
.cell-expand {
  position: absolute; inset: 0;
  display: flex; align-items: center; justify-content: center;
  opacity: 0; pointer-events: none; z-index: 2;
  background: rgba(192,57,43,0);
  transition: opacity .28s ease, background .28s ease;
}
.photo-grid .cell:hover .cell-expand { opacity: 1; background: rgba(192,57,43,.22); }
.cell-expand svg {
  width: 36px; height: 36px; color: #fff;
  filter: drop-shadow(0 2px 10px rgba(0,0,0,.6));
}

/* ── LIGHTBOX ── */
.lightbox {
  position: fixed; inset: 0; z-index: 9999;
  background: rgba(8,3,3,.97);
  display: flex; align-items: center; justify-content: center;
  opacity: 0; pointer-events: none;
  transition: opacity .32s ease;
}
.lightbox.active { opacity: 1; pointer-events: all; }
#lb-img {
  max-width: 88vw; max-height: 85vh;
  width: auto; height: auto;
  object-fit: contain; display: block;
  border: 1.5px solid rgba(192,57,43,.3);
  transform: scale(.92);
  transition: transform .42s cubic-bezier(.16,1,.3,1), opacity .22s ease;
}
.lightbox.active #lb-img { transform: scale(1); }
#lb-img.fade { opacity: 0; transform: scale(.95); }
.lb-btn {
  position: fixed; top: 50%; transform: translateY(-50%);
  background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.1);
  cursor: pointer; color: rgba(255,255,255,.55);
  font-size: 1.6rem; line-height: 1; padding: .85rem 1.05rem;
  transition: background .2s, color .2s, transform .2s;
  z-index: 10000; border-radius: 2px;
}
.lb-btn:hover { background: rgba(192,57,43,.35); color: #fff; transform: translateY(-50%) scale(1.08); }
.lb-prev { left: 1rem; }
.lb-next { right: 1rem; }
.lb-close {
  position: fixed; top: 1.1rem; right: 1.4rem;
  background: none; border: none; cursor: pointer;
  color: rgba(255,255,255,.4); font-size: 1.8rem; line-height: 1;
  transition: color .2s, transform .25s; z-index: 10000; font-weight: 300;
}
.lb-close:hover { color: #fff; transform: rotate(90deg); }
.lb-counter {
  position: fixed; bottom: 1.4rem; left: 50%; transform: translateX(-50%);
  font-family: 'Montserrat', sans-serif;
  font-size: .58rem; font-weight: 600;
  letter-spacing: .22em; text-transform: uppercase;
  color: rgba(255,255,255,.3); white-space: nowrap;
}

/* ── ACTIVE NAV UNDERLINE ── */
.nav-links a { position: relative; }
.nav-links a::after {
  content: '';
  position: absolute; bottom: 0; left: 1.5rem; right: 1.5rem;
  height: 1.5px; background: #c0392b;
  transform: scaleX(0); transform-origin: center;
  transition: transform .25s ease;
}
.nav-links a:hover::after, .nav-links a.nav-active::after { transform: scaleX(1); }
.nav-links a.nav-active { color: #fff; }
@media (max-width: 768px) { .nav-links a::after { display: none; } }

/* ── SERVICE ROW HOVER ACCENT ── */
.svc-row {
  transition: background .18s ease, padding-left .22s cubic-bezier(.16,1,.3,1), box-shadow .18s ease;
}
.svc-row:hover {
  background: rgba(192,57,43,.05);
  padding-left: .75rem;
  box-shadow: inset 2.5px 0 0 #c0392b;
}

/* ── SALON TAG HOVER ── */
.salon-tag { transition: background .18s, color .18s, border-color .18s, transform .2s; }
.salon-tag:hover {
  background: rgba(192,57,43,.15);
  color: rgba(255,255,255,.85);
  border-color: rgba(192,57,43,.4);
  transform: translateY(-1px);
}

/* ── BUTTON SHINE ── */
.btn-main { position: relative; overflow: hidden; }
.btn-main::before {
  content: '';
  position: absolute; top: 0; left: -100%;
  width: 60%; height: 100%;
  background: rgba(255,255,255,.15);
  transform: skewX(-20deg);
  transition: left .45s ease;
}
.btn-main:hover::before { left: 150%; }

/* overflow guards for slide-in reveals */
.about-section, .services-section, .salon-section, .contact-section { overflow: hidden; }

/* ── STATS 3-COL FIX ── */
.stats-inner { grid-template-columns: repeat(3, 1fr); }
@media (max-width: 768px) { .stats-inner { grid-template-columns: repeat(3, 1fr); } }
@media (max-width: 480px) { .stats-inner { grid-template-columns: 1fr; } }

/* ── SALON PRICE LIST SECTION ── */
.salon-prices-section { background: #f5f2ef; padding: 7rem 3rem; overflow: hidden; }
.salon-prices-inner { max-width: 1100px; margin: 0 auto; }
.salon-prices-head { text-align: center; margin-bottom: 4rem; }
.salon-prices-head .label {
  font-family: 'Montserrat', sans-serif;
  font-size: .68rem; font-weight: 700;
  letter-spacing: .24em; text-transform: uppercase;
  color: #c0392b; margin-bottom: .85rem; display: block;
}
.salon-prices-head h2 {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(2.5rem, 5vw, 4rem);
  letter-spacing: .05em; color: #1a1010;
}
.price-categories {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 3rem;
}
.price-cat h3 {
  font-family: 'Bitter', serif;
  font-size: 1rem; font-weight: 700;
  color: #1a1010;
  padding-bottom: .5rem;
  border-bottom: 2px solid #c0392b;
  margin-bottom: 1rem;
}
.salon-price-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: .55rem 0;
  border-bottom: 1px solid #ddd;
  transition: background .18s, padding-left .2s, box-shadow .18s;
}
.salon-price-row:hover {
  background: rgba(192,57,43,.05);
  padding-left: .5rem;
  box-shadow: inset 2px 0 0 #c0392b;
}
.salon-price-row .spn {
  font-family: 'Lato', sans-serif;
  font-size: .88rem; color: #555;
}
.salon-price-row .spp {
  font-family: 'Montserrat', sans-serif;
  font-size: .78rem; font-weight: 700;
  color: #c0392b; white-space: nowrap; margin-left: .5rem;
}
@media (max-width: 1024px) {
  .price-categories { grid-template-columns: repeat(2, 1fr); gap: 2.5rem; }
  .salon-prices-section { padding: 5rem 3rem; }
}
@media (max-width: 600px) {
  .price-categories { grid-template-columns: 1fr; gap: 2rem; }
  .salon-prices-section { padding: 4rem 1.5rem; }
}
</style>
</head>
<body>

